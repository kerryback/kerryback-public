# Optional dev overrides. Copy to .env and fill in. Never commit the real .env.
#
# NOTE: the ElevenLabs key does NOT belong here. A key pasted in the app is
# written to ~/.voiceover/.env, outside the skill directory, so that installing
# or updating the plugin cannot wipe it. A key set here (or exported in your
# shell) still works — an exported variable wins over both files — but this file
# lives inside the package and is replaced on update.
#
# ELEVENLABS_API_KEY=

# Per-project deck folders + working files (no database). The launcher points
# this at the project folder, i.e. {project}/.voiceover.
DATA_DIR=./data

# Parallel TTS requests per build (optional; must not exceed your ElevenLabs
# account's concurrent-request limit)
TTS_CONCURRENCY=5

# Parallel ffmpeg segment encodes per build (optional)
VIDEO_CONCURRENCY=4
